/* Lab Monitor - Chrome dark mode.
 *
 * Palette (kept in sync with lm/ui/theme.hpp):
 *   #202124  background / base      #e8eaed  primary text
 *   #292a2d  surface, headers       #9aa0a6  secondary text
 *   #35363a  hover / selected       #8ab4f8  accent (Chrome blue)
 *   #3c4043  borders, dividers      #aecbfa  accent pressed
 *
 * Anything left unstyled here falls back to the platform style, which on
 * Windows means light widgets in a dark window -- that is how the tab bar
 * ended up white-on-grey. Theme::apply() also installs Fusion plus a dark
 * QPalette so widgets Qt draws itself (message boxes, native dialogs) follow.
 */

QWidget {
    background-color: #202124;
    color: #e8eaed;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: #202124;
}

QToolTip {
    background-color: #292a2d;
    color: #e8eaed;
    border: 1px solid #3c4043;
    padding: 6px 8px;
}

QLabel {
    background: transparent;
    color: #e8eaed;
}

QLabel[muted="true"] {
    color: #9aa0a6;
}

QFrame, QAbstractScrollArea {
    border: 1px solid #3c4043;
    border-radius: 6px;
}

/* ---------------------------------------------------------------- tabs -- */
/* These were absent entirely, so the tab bar fell through to the platform
   style: a white strip with grey text sitting on a dark window. */

QTabWidget::pane {
    background-color: #202124;
    border: 1px solid #3c4043;
    border-radius: 6px;
    top: -1px;
}

QTabBar {
    background: transparent;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background-color: #292a2d;
    color: #9aa0a6;
    border: 1px solid #3c4043;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 7px 16px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #35363a;
    color: #e8eaed;
}

QTabBar::tab:selected {
    background-color: #202124;
    color: #e8eaed;
    border-color: #3c4043;
    /* A blue top edge marks the active tab without relying on hue alone --
       the selected tab is also the only one sharing the pane's background. */
    border-top: 2px solid #8ab4f8;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

/* ------------------------------------------------------------- headers -- */

QHeaderView {
    background-color: #292a2d;
    border: none;
}

QHeaderView::section {
    background-color: #292a2d;
    color: #9aa0a6;
    padding: 3px 8px;
    border: none;
    border-right: 1px solid #3c4043;
    border-bottom: 1px solid #3c4043;
}

QHeaderView::section:hover {
    color: #e8eaed;
}

QTableCornerButton::section {
    background-color: #292a2d;
    border: none;
    border-bottom: 1px solid #3c4043;
}

/* --------------------------------------------------------------- views -- */

QTableView, QTreeView, QListView {
    background-color: #202124;
    alternate-background-color: #252629;
    color: #e8eaed;
    border: 1px solid #3c4043;
    border-radius: 6px;
    gridline-color: #3c4043;
    selection-background-color: #35363a;
    /* Deliberately no selection-color: a stylesheet value here would override
       the model's Qt::ForegroundRole and wipe out the fleet's health colours
       the moment a row is selected. KeepForegroundDelegate governs instead. */
    outline: none;
}

/* Vertical padding stays at 0 so the view's own row height governs: the fleet
   table is sized for ~35 visible hosts and per-item padding would silently
   defeat that. Horizontal padding is unaffected. */
QTableView::item, QTreeView::item, QListView::item {
    padding: 0px 6px;
    border: none;
}

QTableView::item:hover, QTreeView::item:hover, QListView::item:hover {
    background-color: #292a2d;
}

/* Background only. A `color` here would be handed to QRenderRule::configurePalette
   as QPalette::HighlightedText *after* the delegate has set it, silently undoing
   KeepForegroundDelegate and wiping the row's health hue on selection -- which is
   what removing `selection-color` from the rule above alone did not fix. */
QTableView::item:selected, QTreeView::item:selected, QListView::item:selected {
    background-color: #35363a;
}

/* Qt draws no branch arrows under Fusion + stylesheet unless told to; without
   this the Applications/Services groups look unexpandable. */
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    border-image: none;
    image: none;
}

/* ------------------------------------------------------------- buttons -- */

QPushButton {
    background-color: #292a2d;
    color: #e8eaed;
    border: 1px solid #3c4043;
    border-radius: 6px;
    padding: 6px 14px;
}

QPushButton:hover {
    background-color: #35363a;
    border-color: #5f6368;
}

QPushButton:pressed {
    background-color: #3c4043;
}

QPushButton:focus {
    border-color: #8ab4f8;
}

QPushButton:disabled {
    background-color: #252629;
    color: #5f6368;
    border-color: #303134;
}

/* Primary action (Publish). Set with setProperty("primary", true). */
QPushButton[primary="true"] {
    background-color: #8ab4f8;
    color: #202124;
    border: none;
    font-weight: 600;
}

QPushButton[primary="true"]:hover {
    background-color: #aecbfa;
}

QPushButton[primary="true"]:disabled {
    background-color: #303134;
    color: #5f6368;
}

/* --------------------------------------------------------------- input -- */

QLineEdit, QComboBox, QSpinBox, QPlainTextEdit, QTextEdit {
    background-color: #292a2d;
    color: #e8eaed;
    border: 1px solid #3c4043;
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: #8ab4f8;
    selection-color: #202124;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus,
QPlainTextEdit:focus, QTextEdit:focus {
    border-color: #8ab4f8;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    background-color: #252629;
    color: #5f6368;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #292a2d;
    color: #e8eaed;
    border: 1px solid #3c4043;
    selection-background-color: #35363a;
}

QCheckBox, QRadioButton {
    background: transparent;
    color: #e8eaed;
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #5f6368;
    border-radius: 3px;
    background-color: #292a2d;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #8ab4f8;
    border-color: #8ab4f8;
}

QGroupBox {
    border: 1px solid #3c4043;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #9aa0a6;
}

/* ------------------------------------------------------------ chrome  --- */

QSplitter::handle {
    background-color: #3c4043;
}

QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }

QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    border: none;
    width: 12px;
    height: 12px;
    margin: 0;
}

QScrollBar::handle {
    background-color: #3c4043;
    border-radius: 6px;
    min-height: 28px;
    min-width: 28px;
}

QScrollBar::handle:hover {
    background-color: #5f6368;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

QStatusBar {
    background-color: #292a2d;
    color: #9aa0a6;
    border-top: 1px solid #3c4043;
}

QStatusBar::item {
    border: none;
}

QMenuBar, QMenu {
    background-color: #292a2d;
    color: #e8eaed;
    border: 1px solid #3c4043;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
}

QMenuBar::item:selected, QMenu::item:selected {
    background-color: #35363a;
}

QMenu::separator {
    height: 1px;
    background-color: #3c4043;
    margin: 4px 8px;
}

QMessageBox, QInputDialog {
    background-color: #202124;
}
