{
  "name": "lab-monitor",
  "version": "0.1.0",
  "builtin-baseline": "f74a2eade17a628413746557d04db25ccf6e76f9",
  "dependencies": [
    "boost-program-options",
    "nlohmann-json",
    "fastdds",
    "fastcdr",
    "spdlog",
    "gtest"
  ],
  "features": {
    "gui": {
      "description": "Qt Widgets user interfaces",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": [ "gui", "widgets", "testlib", "png", "freetype", "harfbuzz" ]
        },
        {
          "name": "qtbase",
          "default-features": false,
          "features": [ "egl", "fontconfig", "opengl", "xcb", "xcb-sm", "xcb-xlib", "xrender" ],
          "platform": "linux"
        },
        "qtsvg"
      ]
    }
  },
  "default-features": [ "gui" ]
}
